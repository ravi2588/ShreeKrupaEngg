@{
    ViewData["Title"] = "About Us - Shree Krupa Engg";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="row mb-5">
        <div class="col-lg-12">
            <h1 class="display-4 fw-bold mb-3">About Shree Krupa Engg</h1>
            <p class="lead text-muted">Trusted Provider of Premium MNGL Gas Services Since 2010</p>
        </div>
    </div>

    <!-- Company Overview -->
    <div class="row mb-5 align-items-center">
        <div class="col-lg-6 mb-4">
            <div class="about-image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); height: 400px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white;">
                <div class="text-center">
                    <i class="fas fa-gas-pump fa-5x mb-3"></i>
                    <h4>20+ Years of Excellence</h4>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <h2 class="fw-bold mb-4">Our Story</h2>
            <p class="mb-3">Shree Krupa Engg has been a leading provider of premium MNGL gas solutions since its establishment. With over two decades of experience, we have successfully served thousands of clients including 5-star hotels, 3-star hotels, restaurants, and commercial establishments across the region.</p>
            <p class="mb-3">Our commitment to quality, safety, and customer satisfaction has made us the trusted choice for MNGL gas services in the hospitality and commercial sectors.</p>
            <p>We believe in building long-term relationships with our clients by providing reliable, safe, and efficient gas solutions tailored to their specific needs.</p>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row mb-5">
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow p-5 h-100">
                <h4 class="fw-bold mb-3"><i class="fas fa-bullseye text-primary"></i> Our Mission</h4>
                <p>To provide world-class MNGL gas solutions that enhance operational efficiency and safety for our valued clients in the hospitality and commercial sectors.</p>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow p-5 h-100">
                <h4 class="fw-bold mb-3"><i class="fas fa-eye text-primary"></i> Our Vision</h4>
                <p>To be the most trusted and preferred MNGL gas service provider, known for excellence, innovation, and unwavering commitment to customer satisfaction.</p>
            </div>
        </div>
    </div>

    <!-- Why We're Different -->
    <section class="py-5 bg-light rounded-3 mb-5">
        <div class="container">
            <h2 class="fw-bold mb-5 text-center">Why We Stand Out</h2>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center" style="height: 40px; width: 40px; border-radius: 50%; background-color: #ffc107; color: white; font-weight: bold;">1</div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Experience & Expertise</h5>
                            <p class="text-muted mb-0">20+ years of industry experience with deep knowledge of MNGL gas solutions</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center" style="height: 40px; width: 40px; border-radius: 50%; background-color: #ffc107; color: white; font-weight: bold;">2</div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Quality Assurance</h5>
                            <p class="text-muted mb-0">Strict quality control and certification standards ensure best products</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center" style="height: 40px; width: 40px; border-radius: 50%; background-color: #ffc107; color: white; font-weight: bold;">3</div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Safety First</h5>
                            <p class="text-muted mb-0">All operations comply with international safety and regulatory standards</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center" style="height: 40px; width: 40px; border-radius: 50%; background-color: #ffc107; color: white; font-weight: bold;">4</div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">24/7 Availability</h5>
                            <p class="text-muted mb-0">Round-the-clock support and emergency services for your peace of mind</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Key Numbers -->
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="stat-box">
                <h2 class="fw-bold text-primary">1000+</h2>
                <p class="text-muted">Satisfied Clients</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="stat-box">
                <h2 class="fw-bold text-primary">20+</h2>
                <p class="text-muted">Years Experience</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="stat-box">
                <h2 class="fw-bold text-primary">500+</h2>
                <p class="text-muted">5-Star Hotels Served</p>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
        <h3 class="fw-bold mb-4">Ready to Work with Us?</h3>
        <a href="@Url.Action("Enquiry", "Home")" class="btn btn-primary btn-lg">Get in Touch</a>
    </div>
</div>

<style>
    .stat-box {
        padding: 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 10px;
        margin: 20px 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .stat-box h2 {
        color: #ffc107;
    }
</style>
