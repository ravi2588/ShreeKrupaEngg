@{
    ViewData["Title"] = "Home - Premium MNGL Gas Services";
}

<!-- Hero Section with Background Image -->
<div class="hero-section" style="background: linear-gradient(135deg, rgba(30, 60, 114, 0.8) 0%, rgba(42, 82, 152, 0.8) 100%), url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><rect fill=%22%231e3c72%22 width=%221200%22 height=%22600%22/></svg>'); background-size: cover; background-position: center; min-height: 600px; display: flex; align-items: center; justify-content: center; color: white; text-align: center;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">Premium MNGL Gas Solutions</h1>
        <p class="lead mb-5">Excellence in Gas Services for Hotels, Restaurants & Commercial Establishments</p>
        <a href="@Url.Action("Enquiry", "Home")" class="btn btn-warning btn-lg me-3">
            <i class="fas fa-paper-plane"></i> Get Your Quote
        </a>
        <a href="@Url.Action("Services", "Home")" class="btn btn-outline-light btn-lg">
            <i class="fas fa-cogs"></i> Explore Services
        </a>
    </div>
</div>

<!-- Why Choose Us Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Why Choose Shree Krupa Engg?</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow h-100 text-center p-4 hover-lift">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-medal fa-3x text-warning"></i>
                    </div>
                    <h5 class="fw-bold">Premium Quality</h5>
                    <p class="text-muted">Industry-leading MNGL gas products and services meeting international standards</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow h-100 text-center p-4 hover-lift">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-headset fa-3x text-warning"></i>
                    </div>
                    <h5 class="fw-bold">24/7 Support</h5>
                    <p class="text-muted">Round-the-clock customer support and emergency assistance always available</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow h-100 text-center p-4 hover-lift">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-check-circle fa-3x text-warning"></i>
                    </div>
                    <h5 class="fw-bold">Certified & Safe</h5>
                    <p class="text-muted">Fully certified, inspected, and compliant with all safety regulations</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Preview Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Our Services</h2>
        <div class="row">
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="service-card">
                    <div class="service-icon bg-primary text-white">
                        <i class="fas fa-star"></i>
                    </div>
                    <h5 class="mt-3 fw-bold">5-Star Hotels</h5>
                    <p class="text-muted">Premium MNGL gas solutions for luxury hotel kitchens and dining facilities</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="service-card">
                    <div class="service-icon bg-info text-white">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <h5 class="mt-3 fw-bold">Restaurants</h5>
                    <p class="text-muted">Reliable gas supply for commercial kitchens and food service operations</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="service-card">
                    <div class="service-icon bg-success text-white">
                        <i class="fas fa-industry"></i>
                    </div>
                    <h5 class="mt-3 fw-bold">Industries</h5>
                    <p class="text-muted">Customized MNGL gas solutions for industrial and commercial applications</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="service-card">
                    <div class="service-icon bg-danger text-white">
                        <i class="fas fa-wrench"></i>
                    </div>
                    <h5 class="mt-3 fw-bold">Installation & Maintenance</h5>
                    <p class="text-muted">Professional installation and regular maintenance services</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="@Url.Action("Services", "Home")" class="btn btn-primary btn-lg">View All Services</a>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Ready to Partner with Us?</h2>
        <p class="lead mb-5">Get premium MNGL gas services tailored to your business needs</p>
        <a href="@Url.Action("Enquiry", "Home")" class="btn btn-warning btn-lg text-dark fw-bold">
            <i class="fas fa-envelope"></i> Request a Free Consultation
        </a>
    </div>
</section>

<style>
    .hero-section {
        box-shadow: inset 0 0 100px rgba(0,0,0,0.5);
    }

    .hover-lift:hover {
        transform: translateY(-10px);
        transition: all 0.3s ease;
    }

    .service-card {
        padding: 30px;
        border-radius: 10px;
        background: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        text-align: center;
        transition: all 0.3s ease;
        border-top: 4px solid #ffc107;
    }

    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .service-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 28px;
    }

    .feature-icon {
        color: #ffc107;
    }
</style>
