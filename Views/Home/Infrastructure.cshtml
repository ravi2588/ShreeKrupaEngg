@{
    ViewData["Title"] = "Infrastructure - ONGC Gas Services";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Our Infrastructure</h1>
        <p class="lead text-muted">State-of-the-art facilities and equipment for gas distribution</p>
    </div>

    <!-- Infrastructure Overview -->
    <div class="row mb-5 align-items-center">
        <div class="col-lg-6 mb-4">
            <img src="https://images.unsplash.com/photo-1581092160562-40038f56f410?w=600&h=400&fit=crop" alt="Control Center" class="img-fluid rounded-3 shadow">
        </div>
        <div class="col-lg-6">
            <h2 class="fw-bold mb-4">Advanced Distribution Infrastructure</h2>
            <p class="mb-3">Shree Krupa Engg operates a comprehensive network of modern facilities and equipment to ensure reliable and safe ONGC gas distribution across the region.</p>
            <div class="d-flex mb-3">
                <i class="fas fa-check-circle text-success me-3 mt-1" style="font-size: 24px;"></i>
                <div>
                    <h6 class="fw-bold">Control & Monitoring Centers</h6>
                    <p class="text-muted mb-0">Real-time monitoring of gas flow and pressure throughout the network</p>
                </div>
            </div>
            <div class="d-flex mb-3">
                <i class="fas fa-check-circle text-success me-3 mt-1" style="font-size: 24px;"></i>
                <div>
                    <h6 class="fw-bold">Maintenance Facilities</h6>
                    <p class="text-muted mb-0">Equipped workshops for pipeline maintenance and equipment servicing</p>
                </div>
            </div>
            <div class="d-flex mb-3">
                <i class="fas fa-check-circle text-success me-3 mt-1" style="font-size: 24px;"></i>
                <div>
                    <h6 class="fw-bold">Safety Equipment</h6>
                    <p class="text-muted mb-0">Complete safety systems including valves, regulators, and emergency shutdown devices</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Equipment & Machinery -->
    <h2 class="fw-bold mb-5 text-center">Equipment & Machinery</h2>
    <div class="row g-4 mb-5">
        <!-- Compressors -->
        <div class="col-md-6 col-lg-4">
            <div class="equipment-card">
                <div class="equipment-image">
                    <img src="https://images.unsplash.com/photo-1581092056562-40038f56f400?w=400&h=300&fit=crop" alt="Gas Compressor">
                </div>
                <div class="equipment-content">
                    <h5 class="fw-bold">Gas Compressors</h5>
                    <p class="text-muted mb-3">High-capacity compressors for pressure management</p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Capacity: 1000-5000 m³/hour</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Power: 50-150 HP</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Efficiency: 95%+</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Regulators -->
        <div class="col-md-6 col-lg-4">
            <div class="equipment-card">
                <div class="equipment-image">
                    <img src="https://images.unsplash.com/photo-1581092162562-40038f56f401?w=400&h=300&fit=crop" alt="Pressure Regulator">
                </div>
                <div class="equipment-content">
                    <h5 class="fw-bold">Pressure Regulators</h5>
                    <p class="text-muted mb-3">Automatic pressure control systems</p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Pressure Range: 21-70 bar</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Response Time: <100ms</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Accuracy: ±0.5 bar</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Safety Valves -->
        <div class="col-md-6 col-lg-4">
            <div class="equipment-card">
                <div class="equipment-image">
                    <img src="https://images.unsplash.com/photo-1581092162562-40038f56f402?w=400&h=300&fit=crop" alt="Safety Valve">
                </div>
                <div class="equipment-content">
                    <h5 class="fw-bold">Safety Valves</h5>
                    <p class="text-muted mb-3">Overpressure protection systems</p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Activation: Preset pressure</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Response: Instant</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Redundancy: Multiple valves</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Flow Meters -->
        <div class="col-md-6 col-lg-4">
            <div class="equipment-card">
                <div class="equipment-image">
                    <img src="https://images.unsplash.com/photo-1581092162562-40038f56f403?w=400&h=300&fit=crop" alt="Flow Meter">
                </div>
                <div class="equipment-content">
                    <h5 class="fw-bold">Smart Flow Meters</h5>
                    <p class="text-muted mb-3">Digital monitoring and billing systems</p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Accuracy: ±2%</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Real-time data transmission</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Low flow capability</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Control Systems -->
        <div class="col-md-6 col-lg-4">
            <div class="equipment-card">
                <div class="equipment-image">
                    <img src="https://images.unsplash.com/photo-1581092162562-40038f56f404?w=400&h=300&fit=crop" alt="Control Panel">
                </div>
                <div class="equipment-content">
                    <h5 class="fw-bold">Control Systems</h5>
                    <p class="text-muted mb-3">SCADA & automation systems</p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>24/7 monitoring capability</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Remote operation possible</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Alarm & alert systems</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Testing Equipment -->
        <div class="col-md-6 col-lg-4">
            <div class="equipment-card">
                <div class="equipment-image">
                    <img src="https://images.unsplash.com/photo-1581092162562-40038f56f405?w=400&h=300&fit=crop" alt="Testing Equipment">
                </div>
                <div class="equipment-content">
                    <h5 class="fw-bold">Testing Equipment</h5>
                    <p class="text-muted mb-3">Quality assurance and safety testing</p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Pressure test rigs</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Leak detection systems</li>
                        <li><i class="fas fa-arrow-right me-2 text-primary"></i>Quality analyzers</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Facility Locations -->
    <section class="py-5 bg-light rounded-3 mb-5">
        <div class="container">
            <h2 class="fw-bold mb-5 text-center">Facility Locations</h2>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="facility-card">
                        <h5 class="fw-bold mb-3"><i class="fas fa-warehouse text-primary"></i> Main Distribution Center</h5>
                        <p class="text-muted mb-2"><strong>Location:</strong> Central Business District</p>
                        <p class="text-muted mb-2"><strong>Area:</strong> 50,000 sq ft</strong></p>
                        <p class="text-muted mb-2"><strong>Facilities:</strong> Control room, Maintenance workshop, Storage</p>
                        <p class="text-muted mb-2"><strong>Staff:</strong> 50+ technical personnel</strong></p>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="facility-card">
                        <h5 class="fw-bold mb-3"><i class="fas fa-cog text-primary"></i> Maintenance Centers (4 Locations)</h5>
                        <p class="text-muted mb-2"><strong>Coverage:</strong> North, South, East, West zones</strong></p>
                        <p class="text-muted mb-2"><strong>Area Each:</strong> 5,000 sq ft</strong></p>
                        <p class="text-muted mb-2"><strong>24/7 Response:</strong> Emergency service vehicles stationed</p>
                        <p class="text-muted mb-2"><strong>Equipment:</strong> Mobile service vans and tools</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-5" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white; border-radius: 15px;">
        <div class="container text-center">
            <h3 class="fw-bold mb-4">Schedule an Infrastructure Tour</h3>
            <p class="lead mb-5">See our world-class facilities and equipment in action</p>
            <a href="@Url.Action("Contact", "Home")" class="btn btn-warning btn-lg text-dark fw-bold">
                <i class="fas fa-calendar"></i> Book a Tour
            </a>
        </div>
    </section>
</div>

<style>
    .equipment-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        height: 100%;
    }

    .equipment-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .equipment-image {
        width: 100%;
        height: 180px;
        overflow: hidden;
    }

    .equipment-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .equipment-content {
        padding: 20px;
    }

    .facility-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        border-left: 4px solid #ffc107;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    h2::after {
        content: '';
        display: block;
        width: 100px;
        height: 4px;
        background: linear-gradient(135deg, #1e3c72 0%, #ffc107 100%);
        margin: 20px auto 0;
        border-radius: 2px;
    }
</style>
