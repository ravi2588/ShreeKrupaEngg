@{
    ViewData["Title"] = "Our Locations - ONGC Gas Services";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Our Service Locations</h1>
        <p class="lead text-muted">ONGC gas distribution network across the region</p>
    </div>

    <!-- Map Section -->
    <div class="row mb-5">
        <div class="col-lg-12">
            <div class="map-container rounded-3 overflow-hidden shadow" style="height: 500px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white;">
