    <!-- Coverage Map -->
    <h2 class="fw-bold mb-4 text-center">Service Coverage Area</h2>
    <div class="row mb-5">
        <div class="col-lg-12">
            <div class="coverage-info">
                <h5 class="fw-bold mb-3">Our Service Areas Include:</h5>
                <div class="row">
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Central Business Districts</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Hotel & Hospitality Zones</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Industrial Parks</li>
                            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Commercial Centers</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-unstyled">
