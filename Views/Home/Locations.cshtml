                        <p class="mb-2"><i class="fas fa-envelope text-info me-2"></i> central@shreekrupaengg.com</p>
                        <p class="mb-0"><i class="fas fa-clock text-warning me-2"></i> 24/7 Operations</p>
                    </div>
                    <div class="service-badges">
                        <span class="badge bg-primary">Distribution</span>
                        <span class="badge bg-success">Maintenance</span>
