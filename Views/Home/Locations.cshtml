    <!-- CTA Section -->
    <section class="py-5" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white; border-radius: 15px;">
        <div class="container text-center">
            <h3 class="fw-bold mb-4">Find the Service Center Nearest to You</h3>
            <p class="lead mb-5">Connect with our local team for quick and efficient service</p>
            <a href="@Url.Action("Contact", "Home")" class="btn btn-warning btn-lg text-dark fw-bold me-3">
                <i class="fas fa-phone"></i> Call Now
            </a>
            <a href="@Url.Action("Enquiry", "Home")" class="btn btn-light btn-lg">
                <i class="fas fa-envelope"></i> Send Inquiry
            </a>
        </div>
