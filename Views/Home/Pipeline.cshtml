@{
    ViewData["Title"] = "ONGC Yellow Pipeline Network";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">ONGC Yellow Pipeline Network</h1>
        <p class="lead text-muted">Advanced Gas Distribution Infrastructure</p>
    </div>

    <!-- Hero Section -->
    <div class="row mb-5 align-items-center">
        <div class="col-lg-6 mb-4">
            <img src="https://images.unsplash.com/photo-1581092945696-c7e27de7d38a?w=600&h=400&fit=crop" alt="Yellow Pipeline" class="img-fluid rounded-3 shadow">
        </div>
        <div class="col-lg-6">
            <h2 class="fw-bold mb-4">Premium Gas Pipeline Infrastructure</h2>
            <p class="mb-3">Our ONGC yellow pipeline network represents state-of-the-art gas distribution technology designed to serve hotels, restaurants, and commercial establishments with uninterrupted, high-quality gas supply.</p>
            <ul class="list-unstyled">
                <li class="mb-3"><i class="fas fa-check-circle text-success me-3"></i> <strong>High-Pressure Transmission:</strong> Capable of handling maximum load requirements</li>
                <li class="mb-3"><i class="fas fa-check-circle text-success me-3"></i> <strong>Safety Features:</strong> Multiple safety valves and automatic shut-off systems</li>
                <li class="mb-3"><i class="fas fa-check-circle text-success me-3"></i> <strong>Corrosion Resistant:</strong> Yellow-coated pipes for durability and identification</li>
                <li class="mb-3"><i class="fas fa-check-circle text-success me-3"></i> <strong>Smart Monitoring:</strong> Real-time pressure and flow monitoring systems</li>
            </ul>
        </div>
    </div>

    <!-- Pipeline Specifications -->
    <section class="py-5 bg-light rounded-3 mb-5">
        <div class="container">
            <h2 class="fw-bold mb-5 text-center">Pipeline Specifications</h2>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="spec-card">
                        <h5 class="fw-bold mb-3"><i class="fas fa-ruler-combined text-primary"></i> Dimensions</h5>
                        <ul class="list-unstyled text-muted">
                            <li><strong>Pipe Diameter:</strong> 1 inch to 4 inches</li>
                            <li><strong>Material:</strong> Seamless Steel (Yellow Coated)</li>
                            <li><strong>Wall Thickness:</strong> 2.5mm to 5mm</li>
                            <li><strong>Network Coverage:</strong> 50+ km urban & commercial zones</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="spec-card">
                        <h5 class="fw-bold mb-3"><i class="fas fa-gauge text-primary"></i> Pressure & Flow</h5>
                        <ul class="list-unstyled text-muted">
                            <li><strong>Operating Pressure:</strong> 21 bar to 70 bar</li>
                            <li><strong>Maximum Flow Rate:</strong> 500 m³/hour</li>
                            <li><strong>Pressure Regulation:</strong> Automatic at customer point</li>
                            <li><strong>Safety Margin:</strong> 40% above operating pressure</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="spec-card">
                        <h5 class="fw-bold mb-3"><i class="fas fa-shield-alt text-primary"></i> Safety Standards</h5>
                        <ul class="list-unstyled text-muted">
                            <li><strong>ISO Certification:</strong> ISO 9001:2015</li>
                            <li><strong>Regulatory Compliance:</strong> ONGC & Government Standards</li>
                            <li><strong>Regular Inspection:</strong> Every 6 months</li>
                            <li><strong>Emergency Isolation:</strong> Manual & Automated Valves</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="spec-card">
                        <h5 class="fw-bold mb-3"><i class="fas fa-tools text-primary"></i> Installation & Maintenance</h5>
                        <ul class="list-unstyled text-muted">
                            <li><strong>Installation Time:</strong> 2-4 weeks depending on distance</li>
                            <li><strong>Preventive Maintenance:</strong> Quarterly checks</li>
                            <li><strong>24/7 Emergency Service:</strong> Response within 2 hours</li>
                            <li><strong>Repair Downtime:</strong> Minimal with bypass systems</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pipeline Installation Process -->
    <h2 class="fw-bold mb-5 text-center">Installation Process</h2>
    <div class="row mb-5">
        <div class="col-md-3 mb-4">
            <div class="process-step">
                <div class="step-number">1</div>
                <h5 class="fw-bold mt-3">Survey & Assessment</h5>
                <p class="text-muted">Site evaluation and requirement analysis</p>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="process-step">
                <div class="step-number">2</div>
                <h5 class="fw-bold mt-3">Design & Planning</h5>
                <p class="text-muted">Custom pipeline design and safety planning</p>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="process-step">
                <div class="step-number">3</div>
                <h5 class="fw-bold mt-3">Installation</h5>
                <p class="text-muted">Professional installation with quality checks</p>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="process-step">
                <div class="step-number">4</div>
                <h5 class="fw-bold mt-3">Testing & Commission</h5>
                <p class="text-muted">Pressure tests and final certification</p>
            </div>
        </div>
    </div>

    <!-- Pipeline Gallery -->
    <h2 class="fw-bold mb-4 text-center">Pipeline Installation Gallery</h2>
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <img src="https://images.unsplash.com/photo-1581092945696-c7e27de7d38a?w=400&h=300&fit=crop" alt="Pipeline Laying" class="img-fluid rounded-3 shadow">
        </div>
        <div class="col-md-6 col-lg-4">
            <img src="https://images.unsplash.com/photo-1581092162562-40038f56f410?w=400&h=300&fit=crop" alt="Pressure Testing" class="img-fluid rounded-3 shadow">
        </div>
        <div class="col-md-6 col-lg-4">
            <img src="https://images.unsplash.com/photo-1581092160562-40038f56f412?w=400&h=300&fit=crop" alt="Final Installation" class="img-fluid rounded-3 shadow">
        </div>
    </div>

    <!-- CTA Section -->
    <section class="py-5" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white; border-radius: 15px;">
        <div class="container text-center">
            <h3 class="fw-bold mb-4">Ready to Connect to ONGC Pipeline?</h3>
            <p class="lead mb-5">Get professional installation and continuous gas supply for your business</p>
            <a href="@Url.Action("Enquiry", "Home")" class="btn btn-warning btn-lg text-dark fw-bold">
                <i class="fas fa-pipe"></i> Request Connection
            </a>
        </div>
    </section>
</div>

<style>
    .spec-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        border-left: 4px solid #ffc107;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .process-step {
        text-align: center;
        padding: 30px 20px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
    }

    .process-step:hover {
        transform: translateY(-10px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .step-number {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
        margin: 0 auto;
    }

    h2::after {
        content: '';
        display: block;
        width: 100px;
        height: 4px;
        background: linear-gradient(135deg, #1e3c72 0%, #ffc107 100%);
        margin: 20px auto 0;
        border-radius: 2px;
    }
</style>
