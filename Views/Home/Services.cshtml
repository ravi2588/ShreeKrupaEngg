@{
    ViewData["Title"] = "Services - MNGL Gas Solutions";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Our ONGC Gas Services</h1>
        <p class="lead text-muted">Comprehensive gas solutions for various sectors and applications</p>
    </div>

    <!-- ONGC Introduction -->
    <div class="alert alert-info border-0 rounded-3 mb-5 p-4">
        <h5 class="fw-bold mb-3"><i class="fas fa-info-circle me-2"></i> ONGC Gas Distribution Partnership</h5>
        <p class="mb-0">Shree Krupa Engg is an authorized distributor of ONGC (Oil and Natural Gas Corporation) gas services, delivering premium quality fuel across hotels, restaurants, commercial establishments, and industrial facilities with world-class infrastructure and 24/7 support.</p>
    </div>

    <!-- ONGC Gas Features -->
    <div class="row mb-5 g-4">
        <div class="col-md-6">
            <div class="feature-block">
                <img src="https://images.unsplash.com/photo-1581092162562-40038f56f410?w=400&h=300&fit=crop" alt="ONGC Gas Supply" class="img-fluid rounded-3 mb-3">
                <h5 class="fw-bold">ONGC Gas Quality</h5>
                <p class="text-muted">Premium quality gas meeting all international standards with consistent purity and safety certification</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="feature-block">
                <img src="https://images.unsplash.com/photo-1581092945696-c7e27de7d38a?w=400&h=300&fit=crop" alt="Yellow Pipeline" class="img-fluid rounded-3 mb-3">
                <h5 class="fw-bold">Yellow Pipeline Network</h5>
                <p class="text-muted">State-of-the-art yellow pipeline infrastructure ensuring safe and reliable gas distribution</p>
            </div>
        </div>
    </div>

    <!-- Services Grid -->
    <div class="row mb-5">
        <!-- Service 1: 5-Star Hotels -->
        <div class="col-lg-6 mb-4">
            <div class="service-detail-card">
                <div class="service-header" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <i class="fas fa-crown fa-3x text-white"></i>
                </div>
                <div class="service-body">
                    <h3 class="fw-bold mb-3">5-Star Hotel Services</h3>
                    <p class="text-muted mb-3">Premium MNGL gas solutions designed for luxury hotels with high-volume kitchen demands and strict quality standards.</p>
                    <h6 class="fw-bold mb-2">Features:</h6>
                    <ul class="list-unstyled mb-4">
                        <li><i class="fas fa-check-circle text-success me-2"></i>High-capacity supply systems</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Redundancy & backup options</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>24/7 priority support</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Premium safety equipment</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Regular maintenance programs</li>
                    </ul>
                    <a href="@Url.Action("Enquiry", "Home")" class="btn btn-sm btn-primary">Get Quote</a>
                </div>
            </div>
        </div>

        <!-- Service 2: 3-Star Hotels & Restaurants -->
        <div class="col-lg-6 mb-4">
            <div class="service-detail-card">
                <div class="service-header" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-utensils fa-3x text-white"></i>
                </div>
                <div class="service-body">
                    <h3 class="fw-bold mb-3">3-Star Hotels & Restaurants</h3>
                    <p class="text-muted mb-3">Reliable MNGL gas solutions for mid-range hotels and restaurants with balanced cost and quality requirements.</p>
                    <h6 class="fw-bold mb-2">Features:</h6>
                    <ul class="list-unstyled mb-4">
                        <li><i class="fas fa-check-circle text-success me-2"></i>Standard capacity systems</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Cost-effective pricing</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Flexible delivery schedules</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Safety certifications</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Quarterly inspections</li>
                    </ul>
                    <a href="@Url.Action("Enquiry", "Home")" class="btn btn-sm btn-primary">Get Quote</a>
                </div>
            </div>
        </div>

        <!-- Service 3: Commercial Kitchens -->
        <div class="col-lg-6 mb-4">
            <div class="service-detail-card">
                <div class="service-header" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                    <i class="fas fa-fire fa-3x text-white"></i>
                </div>
                <div class="service-body">
                    <h3 class="fw-bold mb-3">Commercial Kitchens</h3>
                    <p class="text-muted mb-3">Optimized MNGL gas supply for catering centers, cloud kitchens, and food courts requiring consistent performance.</p>
                    <h6 class="fw-bold mb-2">Features:</h6>
                    <ul class="list-unstyled mb-4">
                        <li><i class="fas fa-check-circle text-success me-2"></i>On-demand supply management</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Quick response time</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Equipment compatibility check</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Emergency support</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Bulk order discounts</li>
                    </ul>
                    <a href="@Url.Action("Enquiry", "Home")" class="btn btn-sm btn-primary">Get Quote</a>
                </div>
            </div>
        </div>

        <!-- Service 4: Industrial Applications -->
        <div class="col-lg-6 mb-4">
            <div class="service-detail-card">
                <div class="service-header" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">
                    <i class="fas fa-industry fa-3x text-white"></i>
                </div>
                <div class="service-body">
                    <h3 class="fw-bold mb-3">Industrial Applications</h3>
                    <p class="text-muted mb-3">Specialized MNGL gas solutions for manufacturing, processing, and industrial applications with custom configurations.</p>
                    <h6 class="fw-bold mb-2">Features:</h6>
                    <ul class="list-unstyled mb-4">
                        <li><i class="fas fa-check-circle text-success me-2"></i>Custom tank sizes</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Industrial-grade fittings</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Compliance documentation</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Bulk supply agreements</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Technical consultation</li>
                    </ul>
                    <a href="@Url.Action("Enquiry", "Home")" class="btn btn-sm btn-primary">Get Quote</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Services Section -->
    <section class="py-5 bg-light rounded-3">
        <div class="container">
            <h2 class="fw-bold mb-5 text-center">Additional Services</h2>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-tools fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Installation & Setup</h5>
                            <p class="text-muted">Professional installation by certified technicians with complete safety checks and testing</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-double fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Regular Maintenance</h5>
                            <p class="text-muted">Scheduled maintenance programs to ensure optimal performance and safety compliance</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-phone-alt fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Emergency Response</h5>
                            <p class="text-muted">24/7 emergency hotline for immediate assistance and problem resolution</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-graduation-cap fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="fw-bold">Staff Training</h5>
                            <p class="text-muted">Comprehensive training for your staff on safe handling and usage practices</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <div class="text-center mt-5">
        <h3 class="fw-bold mb-4">Interested in Our Services?</h3>
        <a href="@Url.Action("Enquiry", "Home")" class="btn btn-primary btn-lg">Request a Free Consultation</a>
    </div>
</div>

<style>
    .service-detail-card {
        border: none;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        height: 100%;
    }

    .service-detail-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.2);
    }

    .service-header {
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .service-body {
        padding: 30px;
    }
</style>
